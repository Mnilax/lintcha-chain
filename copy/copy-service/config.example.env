# Non-secret shape only. Values are deliberately disabled or empty.
COPY_ENVIRONMENT=preproduction
COPY_CHAIN_ID=4663
COPY_DB_NAMESPACE=lintcha_copy
COPY_APP_ORIGIN=https://lintcha.com
COPY_APP_PATH=/copy/
COPY_API_PATH=/api/copy/

COPY_RPC_PRIMARY_PROVIDER=alchemy
COPY_RPC_PRIMARY_URL=
COPY_RPC_SECONDARY_PROVIDER=drpc
COPY_RPC_SECONDARY_URL=
COPY_RPC_MAX_HEAD_SKEW_BLOCKS=2
COPY_RPC_MAX_GAS_SKEW_BPS=1500

COPY_GLOBAL_KILL_SWITCH=true
COPY_BROADCAST_ENABLED=false
COPY_AUTO_BUY_ENABLED=false
COPY_DELEGATED_SUBMISSION_ENABLED=false

# Production values must be generated from the verified venue manifest.
COPY_ALLOW_CHAINS=[4663]
COPY_ALLOW_ROUTERS=[]
COPY_ALLOW_SPENDERS=[]
COPY_ALLOW_SELECTORS=[]
COPY_MAX_TRANSACTION_WEI=0
COPY_MAX_DAILY_SPEND_WEI=0
COPY_MAX_SLIPPAGE_BPS=0
COPY_MAX_SELL_AMOUNT_BY_TOKEN={}

# Deliberately absent: TELEGRAM_BOT_TOKEN, seed, mnemonic, private key, wallet vault.
